{
  "name": "podcast-index-notify",
  "version": "0.1.0",
  "description": "Tell Podcast Index about a new or changed feed: keyless hub/pubnotify, podping, lookup and wait-until-indexed. Zero dependencies.",
  "keywords": [
    "podcast",
    "podcastindex",
    "podcast-index",
    "pubnotify",
    "podping",
    "rss",
    "podcasting20"
  ],
  "license": "MIT",
  "author": "Chad Farrow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChadFarrow/podcast-index-notify.git"
  },
  "homepage": "https://github.com/ChadFarrow/podcast-index-notify#readme",
  "bugs": {
    "url": "https://github.com/ChadFarrow/podcast-index-notify/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "live:pubnotify": "npm run build && node scripts/live-pubnotify.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3"
  }
}
